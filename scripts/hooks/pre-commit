#!/bin/sh
# pre-commit -- block a commit that would record a drifted Cargo.lock or an unaudited profile claim.
#
# Runs the lock-source guard against the STAGED tree (lock-guard.sh reads the git index, i.e.
# exactly what this commit would record), so a path-drifted, rev-mismatched, or version-skewed
# lock cannot be committed. This is the local first line; CI runs the same script as the hard
# backstop (hooks are opt-in per clone). Then runs the sealed-profile gate over the working tree
# where the repo vendors it, so a `Sealed`/`InProcess` declaration outside the reviewed table
# fails here as well as in CI. Enable in every repo with `just install-hooks` (sets
# `git config core.hooksPath scripts/hooks`), or per repo: git config core.hooksPath scripts/hooks
set -eu

root=$(git rev-parse --show-toplevel)
sh "$root/scripts/lock-guard.sh" "$root"
if [ -f "$root/scripts/sealed-gate.sh" ]; then
    sh "$root/scripts/sealed-gate.sh" "$root"
fi
